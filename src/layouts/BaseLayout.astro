---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';

export type Props = HeadProps & { showHeader?: boolean; showAvatar?: boolean };

const { showHeader = true, showAvatar = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark wrap-break-words antialiased">
    <head>
        <BaseHead {...head} />
        <ClientRouter />
        <script is:inline src="/language-toggle.js"></script>
        <script is:inline src="/theme-toggle.js"></script>
    </head>
    <body class="bg-main text-main">
        <div class="flex min-h-screen flex-col px-4 md:px-8">
            <Nav />
            {showHeader && <Header showAvatar={showAvatar} />}
            <main class="mx-auto w-full max-w-3xl flex-1">
                <slot />
            </main>
            <Footer />
        </div>
    </body>
</html>
