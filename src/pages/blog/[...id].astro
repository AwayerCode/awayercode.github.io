---
import Localized from '../../components/Localized.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { validateContentId } from '../../utils/archive-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { hasContentFiles } from '../../utils/content-files';
import { slugify } from '../../utils/common-utils';

export async function getStaticPaths() {
    const posts = hasContentFiles('src/content/blog')
        ? await getCollection('blog')
        : [];
    posts.forEach((item) => validateContentId(item.id));
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post }
    }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="font-sans text-[26px] leading-[1.4] font-semibold sm:text-[32px]">{title}</h1>
            <div class="mt-3 text-[13px] text-muted">
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                    <>
                        {' '}
                        <span>
                                <Localized zh="（更新于 " en="(Updated " /> <FormattedDate date={updatedDate} /><Localized zh="）" en=")" />
                        </span>
                    </>
                )
            }
        </div>
        </header>
        <div class="prose article-body max-w-none">
            <Content />
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-6 text-sm sm:mt-12 sm:text-base">
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
                        {tags.map((tag) => (
                            <a class="text-main hover:underline" href={`/blog/?tag=${encodeURIComponent(slugify(tag))}`}>
                                #{tag}
                            </a>
                        ))}
                    </div>
                )
            }
            <Button type="button" class="copy-article-button"><Localized zh="复制全文" en="Copy full text" /></Button>
        </div>
    </article>
</BaseLayout>

<script>
    document.addEventListener('astro:page-load', () => {
        const copyArticleButton = document.querySelector<HTMLButtonElement>('.copy-article-button');
        let resetLabel: ReturnType<typeof setTimeout>;
        copyArticleButton?.addEventListener('click', async () => {
            await copyArticle(copyArticleButton);
        });

        async function copyArticle(button: HTMLButtonElement) {
            const label = button.querySelector<HTMLElement>('[data-i18n-zh]');
            if (!label) return;
            function show(zh: string, en: string) {
                label!.dataset.i18nZh = zh;
                label!.dataset.i18nEn = en;
                label!.textContent = document.documentElement.lang === 'en' ? en : zh;
            }
            try {
                const article = button.closest('article');
                const title = article?.querySelector('h1')?.innerText;
                const body = article?.querySelector<HTMLElement>('.article-body')?.innerText;
                if (!title || !body) throw new Error('Article content unavailable');
                await navigator.clipboard.writeText(`${title}\n\n${body}`);
                show('已复制', 'Copied');
            } catch {
                show('复制失败，请重试', 'Copy failed. Try again.');
            }
            clearTimeout(resetLabel);
            resetLabel = setTimeout(() => show('复制全文', 'Copy full text'), 2500);
        }
    });
</script>
