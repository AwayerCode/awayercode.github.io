---
import Localized from '../../components/Localized.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { validateContentId } from '../../utils/archive-utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { hasContentFiles } from '../../utils/content-files';
import { slugify } from '../../utils/common-utils';
import '@fontsource-variable/inter';
import '../../styles/post.css';
import PostEnd from '../../components/PostEnd.astro';
import { readingMinutes } from '../../utils/reading-time';
import PostToc from '../../components/PostToc.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
    const posts = hasContentFiles('src/content/blog')
        ? await getCollection('blog')
        : [];
    posts.forEach((item) => validateContentId(item.id));
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post }
    }));
}

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const minutes = readingMinutes(post.body);
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content, headings } = await render(post);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? excerpt} image={seo?.image} pageType="article" showHeader={false}>
    <ReadingProgress />
    <article class="relative mb-16 sm:mb-24" data-post-article>
        <header class="mb-8">
            <div class="post-meta" data-post-meta>
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                        <span>
                            <Localized zh="更新于 " en="Updated " /><FormattedDate date={updatedDate} />
                        </span>
                    )
                }
                {tags.map((tag) => (
                    <a class="post-meta-tag" href={`/blog/?tag=${encodeURIComponent(slugify(tag))}`}>{tag}</a>
                ))}
                <span data-reading-time={minutes}><Localized zh={`约 ${minutes} 分钟`} en={`${minutes} min read`} /></span>
            </div>
            <h1 class="mt-3 font-sans text-[26px] leading-[1.4] font-semibold sm:text-[32px]">{title}</h1>
        </header>
        <PostToc headings={headings} />
        <div class="prose article-body max-w-none">
            <Content />
        </div>
        <div class="mt-8 flex justify-end sm:mt-12">
            <button
                type="button"
                class="copy-article-button cursor-pointer border-0 bg-transparent p-0 font-sans text-sm text-[var(--muted)] underline-offset-4 transition-colors hover:text-main hover:underline"
            >
                <Localized zh="复制全文" en="Copy full text" />
            </button>
        </div>
        <PostEnd />
        <p class="sr-only" role="status" aria-live="polite" data-anchor-status></p>
    </article>
</BaseLayout>

<script>
    import { destroyPostReading, initPostReading } from '../../scripts/post-reading';
    import { destroyHeadingAnchors, initHeadingAnchors } from '../../scripts/heading-anchors';
    document.addEventListener('astro:before-swap', () => {
        destroyPostReading();
        destroyHeadingAnchors();
    });
    document.addEventListener('astro:page-load', () => {
        initPostReading();
        initHeadingAnchors();
        const copyArticleButton = document.querySelector<HTMLButtonElement>('.copy-article-button');
        let resetLabel: ReturnType<typeof setTimeout>;
        copyArticleButton?.addEventListener('click', async () => {
            await copyArticle(copyArticleButton);
        });

        async function copyArticle(button: HTMLButtonElement) {
            const label = button.querySelector<HTMLElement>('[data-i18n-zh]');
            if (!label) return;
            function show(zh: string, en: string) {
                label!.dataset.i18nZh = zh;
                label!.dataset.i18nEn = en;
                label!.textContent = document.documentElement.lang === 'en' ? en : zh;
            }
            try {
                const article = button.closest('article');
                const title = article?.querySelector('h1')?.innerText;
                const body = article?.querySelector<HTMLElement>('.article-body')?.innerText;
                if (!title || !body) throw new Error('Article content unavailable');
                await navigator.clipboard.writeText(`${title}\n\n${body}`);
                show('已复制', 'Copied');
            } catch {
                show('复制失败，请重试', 'Copy failed. Try again.');
            }
            clearTimeout(resetLabel);
            resetLabel = setTimeout(() => show('复制全文', 'Copy full text'), 2500);
        }
    });
</script>
