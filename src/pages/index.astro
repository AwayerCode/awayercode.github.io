---
import Localized from '../components/Localized.astro';
import { getCollection, render } from 'astro:content';
import Button from '../components/Button.astro';
import EmptyState from '../components/EmptyState.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasContentFiles } from '../utils/content-files';
import { sortItemsByDateDesc } from '../utils/data-utils';

const hasBlogFiles = hasContentFiles('src/content/blog');
const posts = hasBlogFiles ? (await getCollection('blog')).sort(sortItemsByDateDesc) : [];
const featuredPosts = posts.filter(({ data }) => data.isFeatured);
const homePosts = featuredPosts.length > 0 ? featuredPosts : posts.slice(0, siteConfig.postsPerPage || 8);

const hasProjectFiles = hasContentFiles('src/content/projects');
const projects = hasProjectFiles ? (await getCollection('projects')).sort(sortItemsByDateDesc) : [];
const featuredProjects = projects.filter(({ data }) => data.isFeatured);
const homeProjects = featuredProjects.length > 0 ? featuredProjects : projects.slice(0, siteConfig.projectsPerPage || 8);
const pages = await getCollection('pages');
const aboutPage = pages.find((page) => page.id === 'about');
const aboutHasContent = Boolean(aboutPage?.body?.trim());
let AboutContent = null;

if (aboutPage && aboutHasContent) {
    ({ Content: AboutContent } = await render(aboutPage));
}

const sectionTitleClass = 'mb-5 font-serif text-2xl font-medium sm:mb-6 sm:text-3xl';
---

<BaseLayout description={siteConfig.description}>
    <section class="mb-10 sm:mb-12">
        <h2 class={sectionTitleClass}><Localized zh="文章" /></h2>
        {
            posts.length > 0 ? (
                <>
                    {homePosts.map((post) => (
                        <PostPreview post={post} class="mb-10 sm:mb-12" headingLevel="h3" />
                    ))}
                    <div class="mt-12 sm:mt-16">
                        <Button href="/blog"><Localized zh="查看全部文章" /></Button>
                    </div>
                </>
            ) : (
                <EmptyState message="暂无文章，敬请期待。" />
            )
        }
    </section>
    <section class="mb-10 sm:mb-12">
        <h2 class={sectionTitleClass}><Localized zh="项目" /></h2>
        {
            projects.length > 0 ? (
                <>
                    {homeProjects.map((project) => (
                        <ProjectPreview project={project} class="mb-10 sm:mb-12" headingLevel="h3" />
                    ))}
                    <div class="mt-12 sm:mt-16">
                        <Button href="/projects"><Localized zh="查看全部项目" /></Button>
                    </div>
                </>
            ) : (
                <EmptyState message="暂无项目，敬请期待。" />
            )
        }
    </section>
    <section>
        <h2 class={sectionTitleClass}><Localized zh="关于我" /></h2>
        {
            AboutContent ? (
                <div class="prose sm:prose-lg max-w-none">
                    <AboutContent />
                </div>
            ) : (
                <EmptyState message="个人介绍即将更新。" />
            )
        }
    </section>
</BaseLayout>
