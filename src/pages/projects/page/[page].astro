---
import type { CollectionEntry } from 'astro:content';
import Archive from '../../../components/ProjectArchive.astro';
import { getArchivePages, type ArchivePage } from '../../../utils/archive-utils';
export async function getStaticPaths() {
    return (await getArchivePages('projects')).slice(1).map((page) => ({
        params: { page: String(page.currentPage) }, props: { page }
    }));
}
type Props = { page: ArchivePage<CollectionEntry<'projects'>> };
const { page } = Astro.props;
---
<Archive page={page} />
