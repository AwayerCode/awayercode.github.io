---
import Localized from './Localized.astro';
import type { ArchivePage } from '../utils/archive-utils';
import { type CollectionEntry } from 'astro:content';
import EmptyState from './EmptyState.astro';
import Pagination from './Pagination.astro';
import PostPreview from './PostPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

type Props = { page: ArchivePage<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout title="文章" description="浏览全部博客文章。" showHeader={false}>
    <div class="mb-12 flex flex-wrap items-baseline justify-between gap-4 sm:mb-16">
        <h1 class="font-sans text-2xl leading-tight font-semibold sm:text-[28px]"><Localized zh="文章" /></h1>
        <a href="/tags" class="text-sm underline decoration-dashed underline-offset-4 hover:decoration-solid"><Localized zh="按标签浏览" en="Browse by tag" /></a>
    </div>
    {
        blog.length > 0 ? (
            <>
                {blog.map((post) => <PostPreview post={post} class="mb-8 sm:mb-10" />)}
                {page.lastPage > 1 && <Pagination page={page} class="mt-10 sm:mt-12" />}
            </>
        ) : (
            <EmptyState message="暂无文章，敬请期待。" />
        )
    }
</BaseLayout>
