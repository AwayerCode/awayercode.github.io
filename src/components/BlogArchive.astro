---
import Localized from './Localized.astro';
import type { ArchivePage } from '../utils/archive-utils';
import { type CollectionEntry } from 'astro:content';
import EmptyState from './EmptyState.astro';
import Pagination from './Pagination.astro';
import PostPreview from './PostPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

type Props = { page: ArchivePage<CollectionEntry<'blog'>> };

const { page } = Astro.props;
const blog = page.data;
---

<BaseLayout title="文章" description="浏览全部博客文章。" showHeader={false}>
    <h1 class="mb-12 font-serif text-2xl leading-tight italic sm:mb-16 sm:text-4xl"><Localized zh="文章" /></h1>
    {
        blog.length > 0 ? (
            <>
                {blog.map((post) => <PostPreview post={post} class="mb-10 sm:mb-12" />)}
                {page.lastPage > 1 && <Pagination page={page} class="mt-10 sm:mt-12" />}
            </>
        ) : (
            <EmptyState message="暂无文章，敬请期待。" />
        )
    }
</BaseLayout>
