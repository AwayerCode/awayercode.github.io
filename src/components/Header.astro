---
import siteConfig from '../data/site-config';
import { Image } from 'astro:assets';
import CustomImage from './CustomImage.astro';
import heroAvatar from '../assets/avatar.webp';

export type Props = { showAvatar?: boolean };
const { showAvatar = false } = Astro.props;

const titleClass = 'text-[28px] leading-tight font-semibold';
---

<header class="mx-auto mb-8 flex w-full max-w-3xl items-center gap-4 sm:mb-10">
    {
        siteConfig.avatar?.src && (
            <a href="/">
                <CustomImage
                    class="aspect-square w-16 rounded-full object-cover sm:w-20"
                    {...siteConfig.avatar}
                    loading="eager"
                    fetchpriority="high"
                    width={80}
                    height={80}
                    widths={[80, 160]}
                    sizes="80px"
                />
            </a>
        )
    }
    {
        showAvatar && !siteConfig.avatar?.src && (
            <Image class="hero-avatar" src={heroAvatar} alt="" width={48} height={48} widths={[48, 96]} sizes="48px" loading="eager" fetchpriority="high" decoding="async" />
        )
    }
    <div class="grow">
        {
            siteConfig.avatar?.src ? (
                <p class={titleClass}>{siteConfig.title}</p>
            ) : (
                <a class={titleClass} href="/">
                    {siteConfig.title}
                </a>
            )
        }
        {siteConfig.subtitle && <p class="text-sm leading-relaxed text-secondary">{siteConfig.subtitle}</p>}
    </div>
</header>

<style>
    .hero-avatar { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 9999px; object-fit: cover; image-rendering: pixelated; box-shadow: 0 0 0 1px #e5e5e5; }
    :global(html.dark) .hero-avatar { box-shadow: 0 0 0 1px #2a2a2a; }
</style>
