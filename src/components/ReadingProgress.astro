<div class="reading-progress" aria-hidden="true"><div class="reading-progress-bar" data-reading-progress></div></div>

<style>
    .reading-progress { position: fixed; inset: 0 0 auto; height: 2px; z-index: 50; pointer-events: none; }
    .reading-progress-bar { height: 100%; background: var(--post-progress, var(--text-main)); transform: scaleX(0); transform-origin: 0 50%; will-change: transform; }
    @media (min-resolution: 2dppx) { .reading-progress { height: 1.5px; } }
</style>
