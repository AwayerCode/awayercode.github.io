---
import { i18n } from '../utils/i18n';
import { Image } from 'astro:assets';
import siteConfig from '../data/site-config';
import avatar from '../assets/avatar.webp';
---

<section class="post-end" aria-label="文章结尾" data-i18n-zh="文章结尾" data-i18n-en="End of post" data-i18n-attr="aria-label">
    <div class="author-card">
        <Image class="author-avatar" src={avatar} alt={siteConfig.title} width={48} height={48} widths={[48, 96]} sizes="48px" loading="lazy" decoding="async" />
        <div class="author-meta">
            <p class="author-name">{siteConfig.title}</p>
            {siteConfig.subtitle && <p class="author-bio" {...i18n(siteConfig.subtitle)}>{siteConfig.subtitle}</p>}
        </div>
    </div>
</section>

<style>
    .post-end { margin-top: 2.5rem; }
    .author-card { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 0; border-top: 1px solid var(--post-rule, #e5e5e5); }
    .author-avatar { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 9999px; object-fit: cover; image-rendering: pixelated; box-shadow: 0 0 0 1px var(--post-rule, #e5e5e5); }
    .author-meta { min-width: 0; }
    .author-name { margin: 0; font-weight: 600; font-size: 15px; line-height: 1.3; }
    .author-bio { margin: 0.15rem 0 0; font-size: 13px; color: var(--muted); line-height: 1.4; }
</style>
