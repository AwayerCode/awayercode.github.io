---
import { Image } from 'astro:assets';
import siteConfig from '../data/site-config';
import avatar from '../assets/avatar.webp';
---

<section class="post-end" aria-label="文章结尾" data-i18n-zh="文章结尾" data-i18n-en="End of post" data-i18n-attr="aria-label">
    <p class="post-end-mark" aria-hidden="true">— END —</p>
    <div class="author-card">
        <Image class="author-avatar" src={avatar} alt={siteConfig.title} width={56} height={56} widths={[56, 112]} sizes="56px" loading="lazy" decoding="async" />
        <div class="author-meta">
            <p class="author-name">{siteConfig.title}</p>
            {siteConfig.subtitle && <p class="author-bio">{siteConfig.subtitle}</p>}
        </div>
    </div>
</section>

<style>
    .post-end { margin-top: 3.5rem; }
    .post-end-mark { margin: 0 0 2.5rem; text-align: center; font-size: 13px; letter-spacing: 0.3em; color: var(--muted); }
    .author-card { display: flex; align-items: center; gap: 1rem; padding: 1.25rem 0; border-block: 1px solid var(--post-rule, #e5e5e5); }
    .author-avatar { flex: 0 0 auto; width: 56px; height: 56px; border-radius: 9999px; object-fit: cover; image-rendering: pixelated; box-shadow: 0 0 0 1px var(--post-rule, #e5e5e5); }
    .author-meta { min-width: 0; }
    .author-name { margin: 0; font-weight: 600; font-size: 16px; }
    .author-bio { margin: 0.25rem 0 0; font-size: 14px; color: var(--muted); }
</style>
