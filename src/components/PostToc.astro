---
import type { MarkdownHeading } from 'astro';
import Localized from './Localized.astro';

type Props = { headings: MarkdownHeading[] };

const items = Astro.props.headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug);
---

{
    items.length > 0 && (
        <aside class="post-toc-rail">
            <div class="post-toc" data-post-toc>
                <nav aria-label="目录 / Table of contents">
                    <p class="post-toc-title">
                        <Localized zh="目录" en="Contents" />
                    </p>
                    <ol>
                        {items.map((h) => (
                            <li class:list={['post-toc-item', h.depth === 3 && 'is-sub']}>
                                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                                    {h.text}
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
            </div>
        </aside>
    )
}
{
    items.length > 0 && (
        <div class="toc-mobile">
            <button type="button" class="toc-fab" data-toc-fab aria-haspopup="dialog" aria-expanded="false" aria-controls="post-toc-sheet" aria-label="打开目录" data-i18n-zh="打开目录" data-i18n-en="Open table of contents" data-i18n-attr="aria-label">
                <svg class="toc-ring" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                    <circle class="toc-ring-track" cx="20" cy="20" r="16" />
                    <circle class="toc-ring-value" cx="20" cy="20" r="16" data-toc-ring />
                </svg>
                <span class="toc-percent" data-toc-percent aria-hidden="true">0%</span>
            </button>
            <dialog id="post-toc-sheet" class="toc-sheet" data-toc-sheet role="dialog" aria-modal="true" aria-labelledby="post-toc-sheet-title">
                <div class="toc-sheet-panel">
                    <div class="toc-sheet-head">
                        <h2 id="post-toc-sheet-title" class="toc-sheet-title"><Localized zh="目录" en="Contents" /></h2>
                        <button type="button" class="toc-sheet-close" data-toc-close aria-label="关闭目录" data-i18n-zh="关闭目录" data-i18n-en="Close table of contents" data-i18n-attr="aria-label">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                        </button>
                    </div>
                    <ol class="toc-sheet-list">
                        {items.map((h) => (
                            <li class:list={['post-toc-item', h.depth === 3 && 'is-sub']}>
                                <a href={`#${h.slug}`} data-toc-link={h.slug}>
                                    {h.text}
                                </a>
                            </li>
                        ))}
                    </ol>
                </div>
            </dialog>
        </div>
    )
}

<style>
    .post-toc-rail { display: none; }
    .post-toc { font-size: 14px; }
    .post-toc-title { margin: 0 0 0.25rem; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .post-toc ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
    .post-toc-item a { display: block; padding: 0.3rem 0 0.3rem 0.75rem; border-left: 3px solid transparent; color: var(--muted); line-height: 1.45; text-decoration: none; transition: color 0.15s, border-color 0.15s; }
    .post-toc-item.is-sub a { padding-left: 1.5rem; font-size: 13px; }
    .post-toc-item a:hover { color: var(--text-main); }
    .post-toc-item a[aria-current='location'] { color: var(--post-accent, var(--text-main)); border-left-color: var(--post-accent, var(--text-main)); font-weight: 600; }
    @media (min-width: 1280px) {
        .post-toc-rail { display: block; position: absolute; top: 0; bottom: 0; right: 100%; width: 13.5rem; margin: 0 3rem 0 0; }
        .post-toc { position: sticky; top: 2.5rem; max-height: calc(100vh - 5rem); overflow-y: auto; }
    }
    .toc-fab { position: fixed; right: calc(1rem + env(safe-area-inset-right, 0px)); bottom: calc(1rem + env(safe-area-inset-bottom, 0px)); z-index: 40; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; padding: 0; border: 1px solid var(--post-rule, #e5e5e5); border-radius: 999px; background: var(--post-bg, var(--bg-main)); color: var(--text-main); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12); cursor: pointer; }
    .toc-fab:focus-visible { outline: 2px solid var(--post-accent); outline-offset: 2px; }
    .toc-ring { grid-area: 1 / 1; width: 2.75rem; height: 2.75rem; transform: rotate(-90deg); }
    .toc-ring circle { fill: none; stroke-width: 3; }
    .toc-ring-track { stroke: var(--post-rule, #e5e5e5); }
    .toc-ring-value { stroke: var(--post-progress, currentColor); stroke-linecap: round; transition: stroke-dashoffset 0.15s linear; }
    .toc-percent { grid-area: 1 / 1; font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0; }
    .toc-sheet { position: fixed; inset: auto 0 0; width: 100%; max-width: 100%; max-height: 75vh; margin: 0; padding: 0; border: 0; border-radius: 16px 16px 0 0; background: var(--post-bg, var(--bg-main)); color: var(--text-main); box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.18); }
    .toc-sheet[open] { display: flex; animation: toc-sheet-in 0.22s ease-out; }
    .toc-sheet::backdrop { background: rgba(0, 0, 0, 0.35); }
    .toc-sheet-panel { display: flex; flex-direction: column; width: 100%; max-height: 75vh; padding: 0.75rem 1.25rem calc(1rem + env(safe-area-inset-bottom, 0px)); }
    .toc-sheet-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 0.5rem; border-bottom: 1px solid var(--post-rule, #e5e5e5); }
    .toc-sheet-title { margin: 0; font-size: 15px; font-weight: 600; }
    .toc-sheet-close { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; margin-right: -0.5rem; border: 0; border-radius: 999px; background: transparent; color: inherit; cursor: pointer; }
    .toc-sheet-close svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; }
    .toc-sheet-close:focus-visible, .toc-sheet-list a:focus-visible { outline: 2px solid var(--post-accent); outline-offset: 2px; }
    .toc-sheet-list { list-style: none; margin: 0.5rem 0 0; padding: 0; overflow-y: auto; font-size: 15px; }
    .toc-sheet-list .post-toc-item a { padding-block: 0.55rem; }
    .toc-sheet-list .post-toc-item.is-sub a { font-size: 14px; }
    @keyframes toc-sheet-in { from { transform: translateY(100%); } to { transform: none; } }
    @media (min-width: 1280px) { .toc-mobile { display: none; } }
    @media (prefers-reduced-motion: reduce) {
        .post-toc-item a, .toc-ring-value { transition: none; }
        .toc-sheet[open] { animation: none; }
    }
</style>

<style is:global>
    html.toc-sheet-open, html.toc-sheet-open body { overflow: hidden; }
    [data-post-article] :is(h2, h3)[id] { scroll-margin-top: 1.5rem; }
</style>
