---
import type { ArchivePage } from '../utils/archive-utils';
import { type CollectionEntry } from 'astro:content';
import EmptyState from './EmptyState.astro';
import Pagination from './Pagination.astro';
import ProjectPreview from './ProjectPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

type Props = { page: ArchivePage<CollectionEntry<'projects'>> };

const { page } = Astro.props;
const portfolio = page.data;
---

<BaseLayout title="项目" description="查看项目归档与相关展示内容。" showHeader={false}>
    <h1 class="mb-12 font-serif text-2xl leading-tight italic sm:mb-16 sm:text-4xl">项目</h1>
    {
        portfolio.length > 0 ? (
            <>
                {portfolio.map((project) => <ProjectPreview project={project} class="mb-10 sm:mb-12" />)}
                {page.lastPage > 1 && <Pagination page={page} class="mt-10 sm:mt-12" />}
            </>
        ) : (
            <EmptyState message="暂无项目，敬请期待。" />
        )
    }
</BaseLayout>
