---
type Props = { date: Date };

const { date } = Astro.props;
---

<time data-localized-date datetime={date.toISOString()}>
    {
        date.toLocaleDateString('zh-CN', {
            timeZone: 'UTC',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        })
    }
</time>
