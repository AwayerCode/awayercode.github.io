---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks ?? [];
---

<footer class="mx-auto w-full max-w-3xl pt-6 pb-4 sm:pt-8 sm:pb-5">
    <div class="site-footer-row">
        <nav class="site-footer-social" aria-label="社交链接" data-i18n-zh="社交链接" data-i18n-en="Social links" data-i18n-attr="aria-label">
            {socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="me noopener noreferrer">{link.text}</a>
            ))}
            <a href="/rss.xml">RSS</a>
        </nav>
        <p class="site-footer-copy">© {new Date().getFullYear()} {siteConfig.title}</p>
    </div>
</footer>

<style>
    .site-footer-row { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.5rem 1rem; }
    .site-footer-social { display: flex; align-items: center; gap: 1rem; font-size: 13px; }
    .site-footer-social a { color: var(--muted); text-decoration: none; }
    .site-footer-social a:hover { color: var(--text-main); text-decoration: underline; text-underline-offset: 3px; }
    .site-footer-copy { margin: 0; font-size: 12px; color: var(--muted); line-height: 1; }
</style>
