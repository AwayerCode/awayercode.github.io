---
import LanguageToggle from './LanguageToggle.astro';
import Localized from './Localized.astro';
import { i18n } from '../utils/i18n';
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks ?? [];
---

<nav class="relative mx-auto w-full max-w-3xl min-h-10 pt-4 pb-8 sm:min-h-14 sm:pb-12 md:pt-8" aria-label="主导航" {...i18n("主导航", undefined, "aria-label")}>
    {
        navLinks.length > 0 && (
            <ul class="site-tabs flex max-w-[calc(100%-5.5rem)] flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-5 md:gap-x-6">
                {navLinks.map((link) => (
                    <li class="py-1">
                        <NavLink
                            class="text-main font-sans text-[14px] hover:underline hover:decoration-1 hover:underline-offset-[3px] sm:text-[15px] md:text-base"
                            href={link.href}
                        >
                            <Localized zh={link.text} />
                        </NavLink>
                    </li>
                ))}
            </ul>
        )
    }
    <div class="absolute top-4 right-0 z-10 flex items-center gap-2 md:top-8">
        <LanguageToggle />
        <ThemeToggle />
    </div>
</nav>
