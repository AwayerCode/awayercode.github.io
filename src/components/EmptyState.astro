---
import Localized from './Localized.astro';
type Props = {
    message: string;
    class?: string;
};

const { message, class: className } = Astro.props;
---

<div class:list={['border-main rounded-2xl border border-dashed px-6 py-8 text-sm leading-normal text-main/70', className]}>
    <Localized zh={message} />
</div>
